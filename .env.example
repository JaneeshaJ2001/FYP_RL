# Required provider key (default provider: groq)
GROQ_API_KEY=

# Optional alternative provider
# OPENAI_API_KEY=

# Langfuse tracing (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=true

# Application config overrides (all optional)
# CHROMA_DIR=./chroma_db_disaster
# CHROMA_COLLECTION=disaster_rag
# TOP_K=3
# CHUNKS_PATH=dataset_generator/chunk_dataset/chunks_grouped.json
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.1
# SUMMARY_MAX_TOKENS=300
# LANGFUSE_ENABLED=true
# LANGFUSE_TAGS=disaster-rag,langgraph
